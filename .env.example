# Secrets live in Doppler (project criterion-club, configs dev and prd). The backend variables below
# are what it reads; set them in Doppler, not here.
EMBY_SERVER_URL=https://emby.example.com
EMBY_SERVER_API=changeme
SESSION_SECRET=changeme            # long random string; rotating it signs everyone out
CLUB_ADMINS=                       # comma-separated Emby usernames allowed into /admin
# Optional overrides (defaults shown)
# EMBY_PUBLIC_URL=                 # defaults to EMBY_SERVER_URL; what "Watch on Emby" links use
# SECURE_COOKIES=false             # true in production (https)
# MOSAIC_COLLECTION=The Criterion Collection   # Emby collection behind the club page mosaic; empty = off
# DATA_DIR=./data                  # holds club.db and club-art/
# FRONTEND_ORIGIN=http://localhost:5273
# LOG_LEVEL=INFO
# LOG_JSON=false

# docker compose reads these two from a .env next to docker-compose.yml (gitignored). Make the token
# with: doppler configs tokens create local-docker --project criterion-club --config dev --plain
# DOPPLER_TOKEN=dp.st.dev.xxxx
# WEB_PORT=8766
