# Secrets live in Doppler (project criterion_club, config dev). This file lists the variables the
# backend reads; do not put real values here.
EMBY_SERVER_URL=https://emby.example.com
EMBY_SERVER_API=changeme
SESSION_SECRET=changeme            # long random string; rotating it signs everyone out
CLUB_ADMINS=                       # comma-separated Emby usernames allowed into /admin
# Optional overrides (defaults shown)
# EMBY_PUBLIC_URL=                 # defaults to EMBY_SERVER_URL; what "Watch on Emby" links use
# SECURE_COOKIES=false             # true in production (https)
# DATA_DIR=./data                  # holds club.db and club-art/
# FRONTEND_ORIGIN=http://localhost:5273
# LOG_LEVEL=INFO
# LOG_JSON=false
